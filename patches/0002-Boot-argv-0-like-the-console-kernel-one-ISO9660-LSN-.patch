+                g_lastCdError = -1;
+                setReturnS32(ctx, 0);
+                return;
+            }
+            CdFileEntry isoEntry;
+            isoEntry.baseLbn = iso.lsn;
+            isoEntry.sizeBytes = iso.size;
+            isoEntry.sectors = sectorsForBytes(iso.size);
+            if (!writeCdSearchResult(rdram, fileAddr, path, isoEntry))
+            {
+                g_lastCdError = -1;
+                setReturnS32(ctx, 0);
+                return;
