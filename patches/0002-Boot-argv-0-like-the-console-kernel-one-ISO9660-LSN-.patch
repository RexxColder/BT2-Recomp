diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
index 9614016..ff757ac 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
@@ -531,6 +531,25 @@ namespace ps2_syscalls
         }
 
         scheduler.setupCurrentThread(initialStack, stackSize, getRegU32(ctx, 28));
+
+        // $a3 = crt0's _args { int argc; char *argv[16]; char payload[256]; }. The kernel fills it with the
+        // boot arguments; games read argv[0] to tell a disc boot ("cdrom0:\SLUS_123.45;1") from a dev boot.
+        const uint32_t args = getRegU32(ctx, 7);
+        if (args != 0u && getMemPtr(rdram, args) && getMemPtr(rdram, args + 0x44u + 255u))
+        {
+            std::string name = PS2Runtime::getIoPaths().elfPath.filename().string();
+            std::transform(name.begin(), name.end(), name.begin(), [](unsigned char c) { return std::toupper(c); });
+            const std::string bootPath = "cdrom0:\\" + name + ";1";
+            const uint32_t payload = args + 0x44u;
+            uint8_t *dst = getMemPtr(rdram, payload);
+            const size_t len = std::min<size_t>(bootPath.size(), 255u);
+            std::memcpy(dst, bootPath.data(), len);
+            dst[len] = 0;
+            const uint32_t argc = 1u;
+            std::memcpy(getMemPtr(rdram, args), &argc, 4);
+            std::memcpy(getMemPtr(rdram, args + 4u), &payload, 4);
+        }
+
         setReturnU32(ctx, sp);
     }
 
