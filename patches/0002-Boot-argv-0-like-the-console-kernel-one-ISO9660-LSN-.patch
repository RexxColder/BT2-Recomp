+        const std::filesystem::path cdImage = getCdImagePath();
+        if (!cdImage.empty())
+        {
+            // A disc image keeps its own LSNs: the IOP side (cdvdman/FILEIO drivers) reads those same sectors.
+            ps2x::iop::IsoEntry iso;
+            const bool isoFound = ps2x::iop::isoFindFile(
+                [&](uint32_t lsn, uint8_t *dst) { return readHostRange(cdImage, uint64_t(lsn) * kCdSectorSize, dst, kCdSectorSize); },
