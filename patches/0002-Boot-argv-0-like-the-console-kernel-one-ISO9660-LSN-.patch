diff --git a/ps2xIOP/include/ps2x/iop/iso9660.h b/ps2xIOP/include/ps2x/iop/iso9660.h
new file mode 100644
index 0000000..5b87483
--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iso9660.h
@@ -0,0 +1,103 @@
+#pragma once
+
+#include <array>
+#include <cctype>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace ps2x::iop
+{
+    // A file found on an ISO9660 disc: what sceCdSearchFile reports (sceCdlFILE lsn/size).
+    struct IsoEntry
+    {
+        uint32_t lsn = 0u;
+        uint32_t size = 0u;
+        bool directory = false;
+    };
+
+    // Reads one 2048-byte sector of the disc; false when the sector does not exist.
+    using IsoSectorReader = std::function<bool(uint32_t lsn, uint8_t *destination)>;
+
+    namespace iso_detail
+    {
+        inline std::string isoKey(std::string_view name)
+        {
+            const size_t version = name.find(';');
+            if (version != std::string_view::npos)
+                name = name.substr(0u, version);
+            while (!name.empty() && name.back() == '.')
+                name.remove_suffix(1u);
+            std::string key(name);
+            for (char &c : key)
+                c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+            return key;
+        }
+
+        inline uint32_t le32(const uint8_t *p)
+        {
+            return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) |
+                   (static_cast<uint32_t>(p[2]) << 16) | (static_cast<uint32_t>(p[3]) << 24);
+        }
+    }
+
+    // Walks the directory records of a real disc layout, so the LSNs match what a sector read returns.
+    // `path` may carry a device ("cdrom0:"), '\\' or '/' separators and ";1" versions; the match ignores case.
+    inline bool isoFindFile(const IsoSectorReader &read, std::string_view path, IsoEntry &out)
+    {
+        constexpr uint32_t kSector = 2048u;
+        std::array<uint8_t, kSector> sector{};
+        if (!read(16u, sector.data()) || sector[0] != 1u || std::memcmp(sector.data() + 1u, "CD001", 5u) != 0)
+            return false;
+        IsoEntry current{iso_detail::le32(sector.data() + 156u + 2u), iso_detail::le32(sector.data() + 156u + 10u), true};
+
+        if (const size_t colon = path.find(':'); colon != std::string_view::npos)
+            path = path.substr(colon + 1u);
+
+        size_t begin = 0u;
+        while (begin < path.size())
+        {
+            size_t end = path.find_first_of("\\/", begin);
+            if (end == std::string_view::npos)
+                end = path.size();
+            const std::string wanted = iso_detail::isoKey(path.substr(begin, end - begin));
+            begin = end + 1u;
+            if (wanted.empty() || wanted == ".")
+                continue;
+            if (!current.directory)
+                return false;
+
+            bool found = false;
+            const uint32_t sectors = (current.size + kSector - 1u) / kSector;
+            for (uint32_t s = 0u; s < sectors && !found; ++s)
+            {
+                if (!read(current.lsn + s, sector.data()))
+                    return false;
+                for (uint32_t offset = 0u; offset < kSector;)
+                {
+                    const uint8_t length = sector[offset];
+                    if (length == 0u)
+                        break; // records never cross a sector; the rest is padding
+                    const uint8_t idLength = sector[offset + 32u];
+                    const std::string_view id(reinterpret_cast<const char *>(sector.data() + offset + 33u), idLength);
+                    if (!(idLength == 1u && (id[0] == '\0' || id[0] == '\1')) && iso_detail::isoKey(id) == wanted)
+                    {
+                        current = IsoEntry{iso_detail::le32(sector.data() + offset + 2u),
+                                           iso_detail::le32(sector.data() + offset + 10u),
+                                           (sector[offset + 25u] & 0x02u) != 0u};
+                        found = true;
+                        break;
+                    }
+                    offset += length;
+                }
+            }
+            if (!found)
+                return false;
+        }
+        out = current;
+        return true;
+    }
+}
