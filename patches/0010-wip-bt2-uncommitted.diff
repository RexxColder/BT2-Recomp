+    // _sceSifLoadModuleBuffer(iop_addr, arglen, args, int *modres): the libkernel core of sceSifLoadModuleBuffer.
+    // Needs its own entry: the leading-underscore alias went to the public handler, which never writes *modres
+    // (the module's start() result). BT2's sceChk01 loads an IRX embedded in the ELF this way and exits main
+    // unless *modres says the module stayed resident.
+    void _sceSifLoadModuleBuffer(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t resultAddr = getRegU32(ctx, 7); // $a3
+        int32_t startResult = -1;
+        const uint32_t bufferAddr = getRegU32(ctx, 4);
+        std::vector<uint8_t> arguments;
+        constexpr uint32_t kMaxIopModuleArguments = 64u * 1024u;
+        if (!rdram || !runtime || bufferAddr == 0u ||
+            !copyGuestBytesBounded(rdram, getRegU32(ctx, 6), getRegU32(ctx, 5), kMaxIopModuleArguments, arguments))
+        {
+            setReturnS32(ctx, -1);
+            return;
+        }
+        const auto loaded = runtime->loadIopModuleBuffer(bufferAddr, arguments.empty() ? nullptr : arguments.data(),
+                                                         static_cast<uint32_t>(arguments.size()));
+        if (loaded.handled && loaded.moduleId > 0)
+        {
+            startResult = loaded.startResult;
+            trackSifModuleLoadExternal(makeSifModuleBufferTag(rdram, bufferAddr), loaded.moduleId);
+            logSifModuleAction("load-buffer-emulated", loaded.moduleId, makeSifModuleBufferTag(rdram, bufferAddr), 1u);
+        }
+        if (resultAddr != 0u)
+            if (uint8_t *out = getMemPtr(rdram, resultAddr))
+                std::memcpy(out, &startResult, sizeof(startResult));
+        setReturnS32(ctx, loaded.handled && loaded.moduleId > 0 ? loaded.moduleId : -1);
+    }
