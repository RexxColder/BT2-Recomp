+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // Minimal SPU2: no audio output, only the state that IOP sound drivers poll. Sound RAM is filled by DMA and
+    // the data port; each keyed-on voice walks its ADPCM blocks at its pitch (IOP clock), so NAX advances, ENDX
+    // bits set on end blocks, loop flags are followed and IRQA hits raise the SPU interrupt. Drivers such as
+    // Neversoft's EZPCM wait for these to finish loading/streaming sounds.
+    class IopSpu2
+    {
+    public:
+        static constexpr uint32_t RegBase = 0x1F900000u;
+        static constexpr uint32_t RegEnd = 0x1F900800u;
+        static constexpr uint32_t RamBytes = 2u * 1024u * 1024u;
+        static constexpr int Irq = 9;
+
+        IopSpu2();
+
+        void reset();
+
+        [[nodiscard]] static bool owns(uint32_t phys) noexcept { return phys >= RegBase && phys < RegEnd; }
+        [[nodiscard]] uint16_t read16(uint32_t phys) const;
+        void write16(uint32_t phys, uint16_t value);
+
+        // DMA channel 4 (core 0) / 7 (core 1): copies at the core's transfer address (TSA).
+        void dmaWrite(int core, const uint8_t *source, size_t bytes);
+        void dmaRead(int core, uint8_t *destination, size_t bytes);
+        void setDmaReady(int core);
+        // Cycles a DMA of `bytes` takes: auto-DMA (PCM streaming) runs at the 48 kHz output rate.
+        [[nodiscard]] uint64_t dmaCycles(int core, size_t bytes) const;
+
+        // Moves every playing voice forward to `currentCycle` (IOP clock, 36.864 MHz).
+        void advance(uint64_t currentCycle);
+        // True once per raised SPU interrupt.
+        [[nodiscard]] bool takeIrq() noexcept;
+
+    private:
+        struct Voice
+        {
+            uint32_t ssa = 0;  // start address (halfwords)
+            uint32_t lsa = 0;  // loop start
+            uint32_t nax = 0;  // current block
+            uint64_t phase = 0; // cycles * pitch into the current block
+            bool playing = false;
+        };
+
+        [[nodiscard]] uint16_t read16Raw(uint32_t phys) const;
+        [[nodiscard]] uint16_t &reg(uint32_t offset) { return m_regs[offset >> 1u]; }
+        [[nodiscard]] uint16_t reg(uint32_t offset) const { return m_regs[offset >> 1u]; }
+        [[nodiscard]] uint32_t irqAddress(int core) const;
+        [[nodiscard]] bool irqEnabled(int core) const;
+        void checkIrq(int core, uint32_t first, uint32_t count);
+        void keyOn(int core, uint32_t mask);
+        void keyOff(int core, uint32_t mask);
+        void stepBlock(int core, int voice);
+
+        std::vector<uint8_t> m_ram;
+        std::array<uint16_t, 0x400> m_regs{};
+        std::array<std::array<Voice, 24>, 2> m_voices{};
+        std::array<uint32_t, 2> m_endx{};
+        std::array<uint32_t, 2> m_tsa{};
+        mutable uint16_t m_irqInfo = 0;
+        bool m_irqPending = false;
+        uint64_t m_lastCycle = 0;
+    };
+}
