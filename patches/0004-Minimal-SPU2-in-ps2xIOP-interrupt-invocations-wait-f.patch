diff --git a/ps2xIOP/src/emulator/core/iop_spu2.cpp b/ps2xIOP/src/emulator/core/iop_spu2.cpp
new file mode 100644
index 0000000..988fdf5
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.cpp
@@ -0,0 +1,351 @@
+#include "iop_spu2.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        // Offsets inside one core's register window (core 1 = core 0 + 0x400).
+        constexpr uint32_t kCoreSize = 0x400u;
+        constexpr uint32_t kVoicePitch = 0x04u;   // + voice * 0x10
+        constexpr uint32_t kAttr = 0x19Au;
+        constexpr uint32_t kIrqaHi = 0x19Cu;
+        constexpr uint32_t kIrqaLo = 0x19Eu;
+        constexpr uint32_t kKon0 = 0x1A0u;
+        constexpr uint32_t kKon1 = 0x1A2u;
+        constexpr uint32_t kKoff0 = 0x1A4u;
+        constexpr uint32_t kKoff1 = 0x1A6u;
+        constexpr uint32_t kTsaHi = 0x1A8u;
+        constexpr uint32_t kTsaLo = 0x1AAu;
+        constexpr uint32_t kData = 0x1ACu;
+        constexpr uint32_t kAdmas = 0x1B0u;
+        constexpr uint32_t kVoiceAddr = 0x1C0u;   // + voice * 0xC: SSA hi/lo, LSAX hi/lo, NAX hi/lo
+        constexpr uint32_t kVoiceAddrEnd = kVoiceAddr + 24u * 0xCu;
+        constexpr uint32_t kEndx0 = 0x340u;
+        constexpr uint32_t kEndx1 = 0x342u;
+        constexpr uint32_t kStatx = 0x344u;
+        constexpr uint32_t kIrqInfo = 0x7C2u;     // absolute: bit 2 = core 0 IRQ, bit 3 = core 1 IRQ
+
+        constexpr uint16_t kAttrIrqEnable = 0x40u;
+        constexpr uint32_t kAddressMask = 0xFFFFFu; // halfword addresses, 2 MB
+        constexpr uint32_t kBlockHalfwords = 8u;    // 16-byte ADPCM block: header + 28 samples
+        constexpr uint64_t kCyclesPerSample = 768u; // 36.864 MHz / 48 kHz
+        constexpr uint64_t kBlockPhase = 28u * kCyclesPerSample * 0x1000u; // one block at pitch 0x1000
+        constexpr uint32_t kMaxBlocksPerAdvance = 4096u;
+
+        // PS2X_SPU_TRACE=1: DMA transfers, key on/off, end flags and IRQs.
+        bool trace()
+        {
+            static const bool enabled = std::getenv("PS2X_SPU_TRACE") != nullptr;
+            return enabled;
+        }
+
+        // PS2X_SPU_TRACE=2 also logs register accesses (first 4000, then every 100000th).
+        bool traceRegs()
+        {
+            static const bool enabled = [] { const char *v = std::getenv("PS2X_SPU_TRACE"); return v && v[0] == '2'; }();
+            static uint64_t count = 0;
+            if (!enabled)
+                return false;
+            ++count;
+            return count < 4000u || count % 100000u == 0u;
+        }
+    }
+
+    IopSpu2::IopSpu2()
+        : m_ram(RamBytes)
+    {
+        reset();
+    }
+
+    void IopSpu2::reset()
+    {
+        std::fill(m_ram.begin(), m_ram.end(), uint8_t{0});
+        m_regs.fill(0u);
+        for (auto &core : m_voices)
+            core.fill(Voice{});
+        m_endx.fill(0u);
+        m_tsa.fill(0u);
+        m_irqInfo = 0u;
+        m_irqPending = false;
+        m_lastCycle = 0u;
+    }
+
+    uint32_t IopSpu2::irqAddress(int core) const
+    {
+        const uint32_t base = static_cast<uint32_t>(core) * kCoreSize;
+        return ((static_cast<uint32_t>(reg(base + kIrqaHi)) << 16u) | reg(base + kIrqaLo)) & kAddressMask;
+    }
+
+    bool IopSpu2::irqEnabled(int core) const
+    {
+        return (reg(static_cast<uint32_t>(core) * kCoreSize + kAttr) & kAttrIrqEnable) != 0u;
+    }
+
+    void IopSpu2::checkIrq(int core, uint32_t first, uint32_t count)
+    {
+        // Either core's IRQ address can be hit by any access to sound RAM.
+        for (int c = 0; c < 2; ++c)
+        {
+            if (!irqEnabled(c))
+                continue;
+            const uint32_t offset = (irqAddress(c) - first) & kAddressMask;
+            if (offset < count)
+            {
+                if (trace())
+                    std::fprintf(stderr, "[spu2] irq core %d at %05x\n", c, irqAddress(c));
+                m_irqInfo |= static_cast<uint16_t>(4u << c);
+                m_irqPending = true;
+            }
+        }
+        (void)core;
+    }
+
+    uint16_t IopSpu2::read16(uint32_t phys) const
+    {
+        const uint16_t value = read16Raw(phys);
+        if (traceRegs())
+            std::fprintf(stderr, "[spu2] r %03x -> %04x\n", phys - RegBase, value);
+        return value;
+    }
+
+    uint16_t IopSpu2::read16Raw(uint32_t phys) const
+    {
+        const uint32_t offset = phys - RegBase;
+        if (offset == kIrqInfo)
+        {
+            const uint16_t value = m_irqInfo;
+            m_irqInfo = 0u; // reading acknowledges, as the libsd interrupt handler expects
+            return value;
+        }
+        const int core = offset >= kCoreSize ? 1 : 0;
+        const uint32_t local = offset - static_cast<uint32_t>(core) * kCoreSize;
+        if (local >= kVoiceAddr && local < kVoiceAddrEnd)
+        {
+            const uint32_t voiceIndex = (local - kVoiceAddr) / 0xCu;
+            const uint32_t field = (local - kVoiceAddr) % 0xCu;
+            const Voice &voice = m_voices[core][voiceIndex];
+            uint32_t address = 0u;
+            if (field < 4u)
+                address = voice.ssa;
+            else if (field < 8u)
+                address = voice.lsa;
+            else
+            {
+                // NAX: the halfword about to be decoded (header + 4 samples per halfword).
+                const uint64_t sample = voice.phase / (kCyclesPerSample * 0x1000u);
+                address = (voice.nax + 1u + static_cast<uint32_t>(std::min<uint64_t>(sample / 4u, 6u))) & kAddressMask;
+            }
+            return static_cast<uint16_t>((field & 2u) ? (address & 0xFFFFu) : (address >> 16u));
+        }
+        switch (local)
+        {
+        case kEndx0:
+            return static_cast<uint16_t>(m_endx[core] & 0xFFFFu);
+        case kEndx1:
+            return static_cast<uint16_t>(m_endx[core] >> 16u);
+        case kTsaHi:
+            return static_cast<uint16_t>(m_tsa[core] >> 16u);
+        case kTsaLo:
+            return static_cast<uint16_t>(m_tsa[core] & 0xFFFFu);
+        default:
+            return reg(offset);
+        }
+    }
+
+    void IopSpu2::write16(uint32_t phys, uint16_t value)
+    {
+        if (traceRegs())
+            std::fprintf(stderr, "[spu2] w %03x <- %04x\n", phys - RegBase, value);
+        const uint32_t offset = phys - RegBase;
+        if (offset == kIrqInfo)
+        {
+            m_irqInfo = static_cast<uint16_t>(m_irqInfo & ~value);
+            return;
+        }
+        const int core = offset >= kCoreSize ? 1 : 0;
+        const uint32_t local = offset - static_cast<uint32_t>(core) * kCoreSize;
+        if (local >= kVoiceAddr && local < kVoiceAddrEnd)
+        {
+            const uint32_t voiceIndex = (local - kVoiceAddr) / 0xCu;
+            const uint32_t field = (local - kVoiceAddr) % 0xCu;
+            Voice &voice = m_voices[core][voiceIndex];
+            uint32_t *target = field < 4u ? &voice.ssa : field < 8u ? &voice.lsa : &voice.nax;
+            if (field & 2u)
+                *target = (*target & ~0xFFFFu) | value;
+            else
+                *target = ((static_cast<uint32_t>(value) & 0xFu) << 16u) | (*target & 0xFFFFu);
+            *target &= kAddressMask;
+            reg(offset) = value;
+            return;
+        }
+        switch (local)
+        {
+        case kKon0:
+            keyOn(core, value);
+            return;
+        case kKon1:
+            keyOn(core, (static_cast<uint32_t>(value) & 0xFFu) << 16u);
+            return;
+        case kKoff0:
+            keyOff(core, value);
+            return;
+        case kKoff1:
+            keyOff(core, (static_cast<uint32_t>(value) & 0xFFu) << 16u);
+            return;
+        case kEndx0:
+            m_endx[core] &= 0xFF0000u; // a write clears the half it addresses
+            return;
+        case kEndx1:
+            m_endx[core] &= 0x00FFFFu;
+            return;
+        case kTsaHi:
+            m_tsa[core] = (((static_cast<uint32_t>(value) & 0xFu) << 16u) | (m_tsa[core] & 0xFFFFu)) & kAddressMask;
+            return;
+        case kTsaLo:
+            m_tsa[core] = ((m_tsa[core] & ~0xFFFFu) | value) & kAddressMask;
+            return;
+        case kData:
+        {
+            const uint32_t byte = (m_tsa[core] & kAddressMask) * 2u;
+            std::memcpy(m_ram.data() + byte, &value, sizeof(value));
+            checkIrq(core, m_tsa[core], 1u);
+            m_tsa[core] = (m_tsa[core] + 1u) & kAddressMask;
+            return;
+        }
+        default:
+            reg(offset) = value;
+            return;
+        }
+    }
+
+    void IopSpu2::keyOn(int core, uint32_t mask)
+    {
+        if (trace() && mask)
+            std::fprintf(stderr, "[spu2] kon core %d mask %06x\n", core, mask);
+        for (int v = 0; v < 24; ++v)
+        {
+            if ((mask & (1u << v)) == 0u)
+                continue;
+            Voice &voice = m_voices[core][v];
+            voice.nax = voice.ssa & ~(kBlockHalfwords - 1u);
+            voice.phase = 0u;
+            voice.playing = true;
+            m_endx[core] &= ~(1u << v);
+        }
+    }
+
+    void IopSpu2::keyOff(int core, uint32_t mask)
+    {
+        if (trace() && mask)
+            std::fprintf(stderr, "[spu2] koff core %d mask %06x\n", core, mask);
+        // The release envelope is not modelled: the voice goes silent at once (it does not set ENDX).
+        for (int v = 0; v < 24; ++v)
+            if (mask & (1u << v))
+                m_voices[core][v].playing = false;
+    }
+
+    void IopSpu2::stepBlock(int core, int v)
+    {
+        Voice &voice = m_voices[core][v];
+        const uint32_t block = voice.nax & kAddressMask & ~(kBlockHalfwords - 1u);
+        const uint8_t flags = m_ram[block * 2u + 1u];
+        if (flags & 0x04u)
+            voice.lsa = block;
+        checkIrq(core, block, kBlockHalfwords);
+        if (flags & 0x01u)
+        {
+            if (trace())
+                std::fprintf(stderr, "[spu2] end core %d voice %d block %05x%s\n", core, v, block,
+                             (flags & 0x02u) ? " (loop)" : "");
+            m_endx[core] |= 1u << v;
+            voice.nax = voice.lsa & ~(kBlockHalfwords - 1u);
+            if ((flags & 0x02u) == 0u)
+                voice.playing = false; // end without repeat: the voice is released
+        }
+        else
+        {
+            voice.nax = (block + kBlockHalfwords) & kAddressMask;
+        }
+    }
+
+    void IopSpu2::advance(uint64_t currentCycle)
+    {
+        if (currentCycle <= m_lastCycle)
+            return;
+        const uint64_t elapsed = currentCycle - m_lastCycle;
+        m_lastCycle = currentCycle;
+        for (int core = 0; core < 2; ++core)
+        {
+            const uint32_t base = static_cast<uint32_t>(core) * kCoreSize;
+            for (int v = 0; v < 24; ++v)
+            {
+                Voice &voice = m_voices[core][v];
+                if (!voice.playing)
+                    continue;
+                const uint64_t pitch = std::min<uint16_t>(reg(base + static_cast<uint32_t>(v) * 0x10u + kVoicePitch), 0x3FFFu);
+                voice.phase += elapsed * pitch;
+                for (uint32_t steps = 0; voice.playing && voice.phase >= kBlockPhase && steps < kMaxBlocksPerAdvance; ++steps)
+                {
+                    voice.phase -= kBlockPhase;
+                    stepBlock(core, v);
+                }
+                if (voice.phase >= kBlockPhase)
+                    voice.phase %= kBlockPhase;
+            }
+        }
+    }
+
+    void IopSpu2::dmaWrite(int core, const uint8_t *source, size_t bytes)
+    {
+        if (trace())
+            std::fprintf(stderr, "[spu2] dma write core %d tsa %05x bytes %zu admas %x\n", core, m_tsa[core], bytes,
+                         reg(static_cast<uint32_t>(core) * kCoreSize + kAdmas));
+        uint32_t address = m_tsa[core];
+        for (size_t i = 0; i + 1u < bytes; i += 2u)
+        {
+            std::memcpy(m_ram.data() + address * 2u, source + i, 2u);
+            address = (address + 1u) & kAddressMask;
+        }
+        checkIrq(core, m_tsa[core], static_cast<uint32_t>(bytes / 2u));
+        m_tsa[core] = address;
+    }
+
+    void IopSpu2::dmaRead(int core, uint8_t *destination, size_t bytes)
+    {
+        if (trace())
+            std::fprintf(stderr, "[spu2] dma read core %d tsa %05x bytes %zu\n", core, m_tsa[core], bytes);
+        uint32_t address = m_tsa[core];
+        for (size_t i = 0; i + 1u < bytes; i += 2u)
+        {
+            std::memcpy(destination + i, m_ram.data() + address * 2u, 2u);
+            address = (address + 1u) & kAddressMask;
+        }
+        checkIrq(core, m_tsa[core], static_cast<uint32_t>(bytes / 2u));
+        m_tsa[core] = address;
+    }
+
+    void IopSpu2::setDmaReady(int core)
+    {
+        reg(static_cast<uint32_t>(core) * kCoreSize + kStatx) |= 0x80u;
+    }
+
+    uint64_t IopSpu2::dmaCycles(int core, size_t bytes) const
+    {
+        // Auto-DMA feeds the core's PCM input: 16-bit stereo at 48 kHz = 4 bytes per 768 cycles.
+        if (reg(static_cast<uint32_t>(core) * kCoreSize + kAdmas) != 0u)
+            return std::max<uint64_t>(static_cast<uint64_t>(bytes) * kCyclesPerSample / 4u, 64u);
+        return std::max<uint64_t>(static_cast<uint64_t>(bytes) / 2u, 64u);
+    }
+
+    bool IopSpu2::takeIrq() noexcept
+    {
+        const bool pending = m_irqPending;
+        m_irqPending = false;
+        return pending;
+    }
+}
