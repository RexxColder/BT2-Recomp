     bool IopCpuCore::executeInstruction(IopCpuState &cpu)
     {
         const uint32_t pc = cpu.pc;
+        // PS2X_IOP_BREAK=addr[,addr...]: log every execution of these IOP addresses (a0-a3, ra).
+        static const std::vector<uint32_t> breakpoints = []
+        {
+            std::vector<uint32_t> list;
+            if (const char *v = std::getenv("PS2X_IOP_BREAK"))
+                for (const char *p = v; *p;)
+                {
+                    char *end = nullptr;
+                    list.push_back(static_cast<uint32_t>(std::strtoul(p, &end, 16)));
+                    p = (*end == ',') ? end + 1 : end;
+                    if (end == p && *p != '\0')
+                        break;
+                }
+            return list;
+        }();
+        if (!breakpoints.empty() && std::find(breakpoints.begin(), breakpoints.end(), pc) != breakpoints.end())
+            std::fprintf(stderr, "[iop break] pc %08x a0 %08x a1 %08x a2 %08x a3 %08x ra %08x v0 %08x v1 %08x s0 %08x s1 %08x\n", pc, cpu.gpr[4],
+                         cpu.gpr[5], cpu.gpr[6], cpu.gpr[7], cpu.gpr[31], cpu.gpr[2], cpu.gpr[3], cpu.gpr[16], cpu.gpr[17]);
         const uint32_t instruction = m_memory.read32(pc);
         const bool wasDelaySlot = cpu.branchPending;
         const uint32_t priorBranchTarget = cpu.branchTarget;
