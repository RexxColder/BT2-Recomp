             lo = (lo & ~mask) | (id & mask);
             m_privRegs->siglblid = (m_privRegs->siglblid & 0xFFFFFFFF00000000ULL) | lo;
             m_privRegs->csr.fetch_or(0x1);
+            raiseInterruptIfUnmasked(0x1u);
         }
         break;
     }
@@ -1482,7 +1497,10 @@ void GS::writeRegisterUnlocked(uint8_t regAddr, uint64_t value)
             m_backend->Sync(GSSyncReason::Finish);
         }
         if (m_privRegs)
+        {
             m_privRegs->csr.fetch_or(0x2);
+            raiseInterruptIfUnmasked(0x2u);
+        }
         break;
     }
     case GS_REG_LABEL:
@@ -1526,6 +1544,8 @@ void GS::writeRegisterUnlocked(uint8_t regAddr, uint64_t value)
 
