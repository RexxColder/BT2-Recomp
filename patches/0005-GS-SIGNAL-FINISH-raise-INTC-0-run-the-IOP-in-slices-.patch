+                    if (counts[i])
+                        std::fprintf(stderr, " %02x:%llu", i, static_cast<unsigned long long>(counts[i]));
+                std::fprintf(stderr, "\n");
+            }
+        }
+
         // Track most-recent command for VIFn_CODE emulation.
         vif1_regs.code = cmd;
         vif1_regs.num = num;
