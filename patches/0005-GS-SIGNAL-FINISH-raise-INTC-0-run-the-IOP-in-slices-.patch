             totalCycles = 0;
             totalInstructions = 0;
             eeCycleCarry = 0;
+            pendingIopCycles = 0u;
             activeCpu = nullptr;
             lastError.clear();
             servicingDmaInterrupts = false;
@@ -727,6 +728,7 @@ namespace ps2x::iop::detail
         uint64_t totalCycles = 0;
         uint64_t totalInstructions = 0;
         uint64_t eeCycleCarry = 0;
+        uint64_t pendingIopCycles = 0u;
         CpuState *activeCpu = nullptr;
         std::string lastError;
         bool servicingDmaInterrupts = false;
@@ -767,11 +769,18 @@ namespace ps2x::iop::detail
     void IopEmulator::runEeCycles(uint64_t eeCycles) noexcept
     {
         const uint64_t total = m_impl->eeCycleCarry + eeCycles;
-        const uint64_t iopCycles = total / 8u;
         m_impl->eeCycleCarry = total % 8u;
-        if (iopCycles)
+        // The EE charges a few cycles per guest call, so running the IOP on every call meant 1-cycle slices, each
+        // walking the thread table (half of all host time). Run it in slices of at least kDefaultSlice cycles;
+        // RPCs and SIF commands still reach it synchronously.
+        m_impl->pendingIopCycles += total / 8u;
+        if (m_impl->pendingIopCycles >= kDefaultSlice)
+        {
+            const uint64_t iopCycles = m_impl->pendingIopCycles;
+            m_impl->pendingIopCycles = 0u;
             m_impl->runCycles(iopCycles);
-        m_impl->rpc.deliverPendingCommands(*m_impl);
+            m_impl->rpc.deliverPendingCommands(*m_impl);
+        }
     }
 
     RpcResult IopEmulator::handleRpc(const RpcRequest &request)
