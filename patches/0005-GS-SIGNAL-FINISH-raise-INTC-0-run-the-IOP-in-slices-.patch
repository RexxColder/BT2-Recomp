+void GS::raiseInterruptIfUnmasked(uint32_t csrBit)
+{
+    // IMR bits 8 (SIGMSK) and 9 (FINISHMSK): 1 = masked. CSR bit 0 = SIGNAL, bit 1 = FINISH.
+    const uint64_t imr = m_privRegs ? m_privRegs->imr : 0xFF00u;
+    const uint64_t maskBit = (csrBit == 0x1u) ? 0x100u : 0x200u;
+    if ((imr & maskBit) == 0u && m_interruptCallback)
+        m_interruptCallback();
+}
+
 void GS::reset()
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
