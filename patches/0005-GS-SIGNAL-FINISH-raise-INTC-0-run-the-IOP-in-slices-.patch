         uint8_t num = (cmd >> 16) & 0xFF;
         const bool irq = (cmd & 0x80000000u) != 0u;
 
+        // PS2X_VIF_TRACE=1: count VIF1 codes, print the histogram every 4096 codes.
+        static const bool vifTrace = std::getenv("PS2X_VIF_TRACE") != nullptr;
+        if (vifTrace)
+        {
+            static uint64_t counts[128] = {};
+            static uint64_t total = 0;
+            ++counts[opcode];
+            if ((++total & 4095u) == 0u)
+            {
+                std::fprintf(stderr, "[vif1 codes after %llu]", static_cast<unsigned long long>(total));
