diff --git a/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h b/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h
new file mode 100644
index 0000000..e2b04ad
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_threaded_backend.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+// Runs another raster backend on its own thread, so the GS draws while the EE keeps running (on the console the
+// GS is a separate chip). Writes (draws, CLUT loads, uploads, flushes) are queued in order; anything that reads
+// GS state (presentation, VRAM reads, readbacks, transfer status) first waits for the commands queued before it.
+// The wrapped backend keeps its own lock, so a read and the worker never touch VRAM at the same time.
+// With a GSCpuBackend inside, consecutive draws are rasterized by several threads at once, each owning every
+// N-th scanline (PS2X_GS_THREADS=N, default: cores - 2, at most 8).
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    explicit GSThreadedBackend(std::unique_ptr<GSRasterBackend> inner);
+    ~GSThreadedBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    using Command = std::function<void(GSRasterBackend &)>;
+    struct Item
+    {
+        bool isDraw = false;
+        GSPrimitiveBatch batch{};
+        Command command;
+    };
+
+    void enqueue(Command command);
+    void push(Item item);
+    void drawBanded(const std::vector<GSPrimitiveBatch> &batches);
+    void helperLoop(int index);
+    // Waits until every command queued so far has run.
+    void drain() const;
+    void workerLoop();
+
+    std::unique_ptr<GSRasterBackend> m_inner;
+    mutable std::mutex m_queueMutex;
+    mutable std::condition_variable m_queueCv;
+    mutable std::condition_variable m_doneCv;
+    std::deque<Item> m_queue;
+    uint64_t m_enqueued = 0;
+    uint64_t m_completed = 0;
+    bool m_stop = false;
+    std::thread m_worker;
+
+    // Serializes the wrapped backend between the worker and direct (read) calls.
+    mutable std::mutex m_innerLock;
+
+    // Band helpers.
+    class GSCpuBackend *m_cpu = nullptr;
+    int m_bands = 1;
+    std::vector<std::thread> m_helpers;
+    std::mutex m_bandMutex;
+    std::condition_variable m_bandCv;
+    std::condition_variable m_bandDoneCv;
+    const std::vector<GSPrimitiveBatch> *m_bandWork = nullptr;
+    uint64_t m_bandGeneration = 0;
+    int m_bandPending = 0;
+    bool m_bandStop = false;
+};
