+void GSCpuBackend::SetThreadBand(int index, int count, GSMem::TexturePageCache *cache) noexcept
+{
+    t_bandIndex = index;
+    t_bandCount = count > 0 ? count : 1;
+    t_bandCache = cache;
+}
