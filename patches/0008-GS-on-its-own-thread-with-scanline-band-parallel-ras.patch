diff --git a/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp b/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp
new file mode 100644
index 0000000..f8ac8d2
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp
@@ -0,0 +1,282 @@
+#include "runtime/gs/gs_threaded_backend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <utility>
+
+namespace
+{
+    // Above this many pending commands the producer waits, bounding memory and latency.
+    constexpr size_t kMaxQueuedCommands = 65536u;
+    // Consecutive draws handed to the band threads at once.
+    constexpr size_t kMaxDrawsPerBatch = 1024u;
+
+    int bandCountFromEnvironment()
+    {
+        if (const char *value = std::getenv("PS2X_GS_THREADS"))
+            return std::clamp(std::atoi(value), 1, 16);
+        const unsigned cores = std::thread::hardware_concurrency();
+        return std::clamp(static_cast<int>(cores) - 2, 1, 8);
+    }
+}
+
+GSThreadedBackend::GSThreadedBackend(std::unique_ptr<GSRasterBackend> inner)
+    : m_inner(std::move(inner))
+{
+    m_cpu = dynamic_cast<GSCpuBackend *>(m_inner.get());
+    m_bands = m_cpu ? bandCountFromEnvironment() : 1;
+    for (int index = 1; index < m_bands; ++index)
+        m_helpers.emplace_back([this, index]() { helperLoop(index); });
+    m_worker = std::thread([this]() { workerLoop(); });
+}
+
+GSThreadedBackend::~GSThreadedBackend()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_queueMutex);
+        m_stop = true;
+    }
+    m_queueCv.notify_all();
+    if (m_worker.joinable())
+        m_worker.join();
+    {
+        std::lock_guard<std::mutex> lock(m_bandMutex);
+        m_bandStop = true;
+    }
+    m_bandCv.notify_all();
+    for (std::thread &helper : m_helpers)
+        if (helper.joinable())
+            helper.join();
+}
+
+void GSThreadedBackend::helperLoop(int index)
+{
+    GSMem::TexturePageCache cache;
+    GSCpuBackend::SetThreadBand(index, m_bands, &cache);
+    uint64_t seen = 0;
+    for (;;)
+    {
+        const std::vector<GSPrimitiveBatch> *work = nullptr;
+        {
+            std::unique_lock<std::mutex> lock(m_bandMutex);
+            m_bandCv.wait(lock, [&]() { return m_bandStop || m_bandGeneration != seen; });
+            if (m_bandStop)
+                return;
+            seen = m_bandGeneration;
+            work = m_bandWork;
+        }
+        cache.Invalidate(); // VRAM may have changed (uploads, flushes) since the last batch
+        for (const GSPrimitiveBatch &batch : *work)
+            m_cpu->SubmitUnlocked(batch);
+        {
+            std::lock_guard<std::mutex> lock(m_bandMutex);
+            --m_bandPending;
+        }
+        m_bandDoneCv.notify_one();
+    }
+}
+
+void GSThreadedBackend::drawBanded(const std::vector<GSPrimitiveBatch> &batches)
+{
+    if (m_bands <= 1)
+    {
+        for (const GSPrimitiveBatch &batch : batches)
+            m_cpu ? m_cpu->SubmitUnlocked(batch) : m_inner->Submit(batch);
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_bandMutex);
+        m_bandWork = &batches;
+        m_bandPending = m_bands - 1;
+        ++m_bandGeneration;
+    }
+    m_bandCv.notify_all();
+
+    static thread_local GSMem::TexturePageCache cache;
+    cache.Invalidate();
+    GSCpuBackend::SetThreadBand(0, m_bands, &cache);
+    for (const GSPrimitiveBatch &batch : batches)
+        m_cpu->SubmitUnlocked(batch);
+    GSCpuBackend::SetThreadBand(0, 1, nullptr);
+
+    std::unique_lock<std::mutex> lock(m_bandMutex);
+    m_bandDoneCv.wait(lock, [this]() { return m_bandPending == 0; });
+}
+
+void GSThreadedBackend::workerLoop()
+{
+    std::vector<GSPrimitiveBatch> draws;
+    draws.reserve(kMaxDrawsPerBatch);
+    for (;;)
+    {
+        Item item;
+        size_t taken = 0;
+        {
+            std::unique_lock<std::mutex> lock(m_queueMutex);
+            m_queueCv.wait(lock, [this]() { return m_stop || !m_queue.empty(); });
+            if (m_queue.empty())
+                return;
+            if (m_queue.front().isDraw)
+            {
+                draws.clear();
+                while (!m_queue.empty() && m_queue.front().isDraw && draws.size() < kMaxDrawsPerBatch)
+                {
+                    draws.push_back(std::move(m_queue.front().batch));
+                    m_queue.pop_front();
+                }
+                taken = draws.size();
+            }
+            else
+            {
+                item = std::move(m_queue.front());
+                m_queue.pop_front();
+                taken = 1;
+            }
+        }
+        m_doneCv.notify_all(); // room in the queue
+        {
+            std::lock_guard<std::mutex> lock(m_innerLock);
+            if (item.command)
+                item.command(*m_inner);
+            else
+                drawBanded(draws);
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_queueMutex);
+            m_completed += taken;
+        }
+        m_doneCv.notify_all();
+    }
+}
+
+void GSThreadedBackend::push(Item item)
+{
+    {
+        std::unique_lock<std::mutex> lock(m_queueMutex);
+        m_doneCv.wait(lock, [this]() { return m_queue.size() < kMaxQueuedCommands; });
+        m_queue.push_back(std::move(item));
+        ++m_enqueued;
+    }
+    m_queueCv.notify_one();
+}
+
+void GSThreadedBackend::enqueue(Command command)
+{
+    Item item;
+    item.command = std::move(command);
+    push(std::move(item));
+}
+
+void GSThreadedBackend::drain() const
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    const uint64_t target = m_enqueued;
+    m_doneCv.wait(lock, [this, target]() { return m_completed >= target; });
+}
+
+void GSThreadedBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    drain();
+    std::lock_guard<std::mutex> lock(m_innerLock);
+    m_inner->Initialize(vram, vramSize);
+}
+
+void GSThreadedBackend::Reset()
+{
+    drain();
+    std::lock_guard<std::mutex> lock(m_innerLock);
+    m_inner->Reset();
+}
+
+void GSThreadedBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    Item item;
+    item.isDraw = true;
+    item.batch = batch;
+    push(std::move(item));
+}
+
+void GSThreadedBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    enqueue([tex0, texclut](GSRasterBackend &backend) { backend.LoadClut(tex0, texclut); });
+}
+
+void GSThreadedBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    enqueue([command](GSRasterBackend &backend) { backend.BeginTransfer(command); });
+}
+
+void GSThreadedBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || sizeBytes == 0u)
+        return;
+    std::vector<uint8_t> copy(data, data + sizeBytes);
+    enqueue([copy = std::move(copy)](GSRasterBackend &backend)
+            { backend.UploadImage(copy.data(), static_cast<uint32_t>(copy.size())); });
+}
+
+void GSThreadedBackend::Flush()
+{
+    enqueue([](GSRasterBackend &backend) { backend.Flush(); });
+}
+
+void GSThreadedBackend::TextureFlush()
+{
+    enqueue([](GSRasterBackend &backend) { backend.TextureFlush(); });
+}
+
+void GSThreadedBackend::Sync(GSSyncReason reason)
+{
+    enqueue([reason](GSRasterBackend &backend) { backend.Sync(reason); });
+    // Readbacks need the drawing done; FINISH/presentation only need ordering, which the queue gives.
+    if (reason == GSSyncReason::DebugReadback || reason == GSSyncReason::Reset)
+        drain();
+}
+
+PresentationFrame GSThreadedBackend::Present(const GSPresentationRequest &request)
+{
+    drain();
+    std::lock_guard<std::mutex> lock(m_innerLock);
+    return m_inner->Present(request);
+}
+
+bool GSThreadedBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    drain();
+    std::lock_guard<std::mutex> lock(m_innerLock);
+    return m_inner->ClearFramebuffer(context, rgba);
+}
+
+uint32_t GSThreadedBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    drain();
+    std::lock_guard<std::mutex> lock(m_innerLock);
+    return m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSThreadedBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    drain();
+    std::lock_guard<std::mutex> lock(m_innerLock);
+    return m_inner->ReadVram(psm, base, bw, x, y);
+}
+
+void GSThreadedBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    enqueue([=](GSRasterBackend &backend) { backend.WriteVram(psm, base, bw, x, y, value); });
+}
+
+void GSThreadedBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    drain();
+    std::lock_guard<std::mutex> lock(m_innerLock);
+    m_inner->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSThreadedBackend::GetTransferSnapshot() const
+{
+    // Only used for debug history (taken on every draw): no drain and no lock, the inner backend locks itself;
+    // the value may lag the queue slightly.
+    return m_inner->GetTransferSnapshot();
+}
