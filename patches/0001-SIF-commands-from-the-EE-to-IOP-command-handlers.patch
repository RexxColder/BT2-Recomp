diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp
index 07fcd29..3e690a8 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/RPC.cpp
@@ -981,9 +981,13 @@ namespace ps2_syscalls
         readStackU32(rdram, sp, 0x10, destExtra);
         readStackU32(rdram, sp, 0x14, sizeExtra);
 
-        if (sizeExtra > 0 && srcExtra && destExtra)
+        // The extra data goes EE -> IOP: copy it into IOP memory (the destination is an IOP address).
+        if (sizeExtra > 0 && sizeExtra <= 0x100000u && srcExtra && destExtra && runtime)
         {
-            rpcCopyToRdram(rdram, destExtra, srcExtra, sizeExtra);
+            std::vector<uint8_t> payload(sizeExtra);
+            for (uint32_t i = 0; i < sizeExtra; ++i)
+                payload[i] = rdram[(srcExtra + i) & PS2_RAM_MASK];
+            (void)runtime->writeIopMemory(destExtra, payload.data(), payload.size());
         }
 
         static int logCount = 0;
@@ -996,6 +1000,21 @@ namespace ps2_syscalls
             ++logCount;
         }
 
+        // Deliver the command to the IOP module that registered a handler for it (user commands such as a
+        // game's own IRX driver). The header is what the SIF hardware sends: size | extra size << 8, the extra
+        // data's destination, the command id, an optional word.
+        if (runtime && packetAddr != 0u && packetSize >= 16u && packetSize <= 112u)
+        {
+            uint8_t packet[112];
+            for (uint32_t i = 0; i < packetSize; ++i)
+                packet[i] = rdram[(packetAddr + i) & PS2_RAM_MASK];
+            const uint32_t sizeWord = packetSize | (sizeExtra << 8u);
+            std::memcpy(packet + 0u, &sizeWord, 4u);
+            std::memcpy(packet + 4u, &destExtra, 4u);
+            std::memcpy(packet + 8u, &cid, 4u);
+            (void)PS2IopTransport::sendCommand(runtime, rdram, ctx, cid, packet, packetSize);
+        }
+
         // Return non-zero on success.
         setReturnS32(ctx, 1);
     }
