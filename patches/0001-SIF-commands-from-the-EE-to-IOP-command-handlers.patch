+    bool IopRpcBridge::handleCommand(uint32_t commandId, const uint8_t *packet, uint32_t packetSize,
+                                     IopGuestExecutor &executor)
+    {
+        if (packet == nullptr || packetSize == 0u || packetSize > 112u)
+            return false;
+        const auto it = m_cmdHandlers.find(commandId);
+        if (it == m_cmdHandlers.end() || it->second.function == 0u)
+        {
+            // On the console the IOP module runs in parallel and has registered its handler by the time the EE
+            // sends; here its thread may not have run yet. Keep the command until a handler shows up.
+            m_pendingCommands.push_back(PendingCommand{commandId, std::vector<uint8_t>(packet, packet + packetSize)});
+            return true;
+        }
+        // The packet lands in the module's command buffer (sceSifSetCmdBuffer); without one, in a scratch
+        // allocation kept for later commands.
+        if (m_cmdBuffer == 0u)
+            m_cmdBuffer = m_memory.allocate(128u, 16u);
+        if (m_cmdBuffer == 0u || !m_memory.writeRam(m_cmdBuffer, packet, packetSize))
+            return false;
+        (void)executor.executeGuestFunction(it->second.function, m_cmdBuffer, it->second.data, 0u, 0u, it->second.gp);
+        return true;
+    }
+
+    void IopRpcBridge::deliverPendingCommands(IopGuestExecutor &executor)
+    {
+        for (size_t i = 0; i < m_pendingCommands.size();)
+        {
+            const auto it = m_cmdHandlers.find(m_pendingCommands[i].commandId);
+            if (it == m_cmdHandlers.end() || it->second.function == 0u)
+            {
+                ++i;
+                continue;
+            }
+            PendingCommand command = std::move(m_pendingCommands[i]);
+            m_pendingCommands.erase(m_pendingCommands.begin() + static_cast<std::ptrdiff_t>(i));
+            (void)handleCommand(command.commandId, command.packet.data(), static_cast<uint32_t>(command.packet.size()),
+                                executor);
+        }
+    }
+
     RpcResult IopRpcBridge::handleRpc(const RpcRequest &request, IopGuestExecutor &executor)
     {
         RpcResult result{};
