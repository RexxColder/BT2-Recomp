+    cache.width = width;
+    cache.height = height;
+    cache.tbp0 = tex.tbp0;
+    cache.tbw = tex.tbw;
+    cache.psm = tex.psm;
+    cache.cbp = tex.cbp;
+    cache.cpsm = tex.cpsm;
