+
+    cache.rgba.resize(static_cast<size_t>(width) * height);
+    for (uint32_t y = 0; y < height; ++y)
+    {
+        for (uint32_t x = 0; x < width; ++x)
+        {
+            const u32 out = ReadTextureVramUnlocked(tex.psm, tex.tbp0, tex.tbw, x, y);
+            uint32_t texel = 0xFFFF00FFu;
