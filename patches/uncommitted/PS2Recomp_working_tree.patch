+    if (cache.valid && cache.width == width && cache.height == height && cache.tbp0 == tex.tbp0 &&
+        cache.tbw == tex.tbw && cache.psm == tex.psm && cache.cbp == tex.cbp && cache.cpsm == tex.cpsm &&
+        cache.csm == tex.csm && cache.csa == tex.csa && cache.ta0 == state.texa.ta0 &&
+        cache.ta1 == state.texa.ta1 && cache.aem == (state.texa.aem ? 1u : 0u) &&
+        cache.generation == generation)
