+void GSCpuBackend::DecodeTexture(const GSDrawState &state, uint32_t *dst, uint32_t width, uint32_t height)
+{
+    if (!dst || width == 0u || height == 0u)
+        return;
+
+    // Feed SampleTexture the same coordinates DrawSprite builds for a pixel, so FST and non-FST agree.
+    // PS2X_GS_GL_TEXLOG=1: is the VRAM read itself empty, or is SampleTexture losing it?
+    if (const char *v = std::getenv("PS2X_GS_GL_TEXLOG"))
+    {
+        const auto &t = state.context.tex0;
+        const uint32_t direct = ReadTextureVramUnlocked(t.psm, t.tbp0, t.tbw, 0, 0);
+        std::fprintf(stderr, "[dec] vram=%p tbp=%x tbw=%u psm=%x fst=%u direct(0,0)=%08x clut=%02x%02x%02x%02x\n",
+                     static_cast<const void *>(m_vram), t.tbp0, t.tbw, t.psm,
+                     state.prim.fst ? 1u : 0u, direct, m_clut[0], m_clut[1], m_clut[2], m_clut[3]);
+        (void)v;
+    }
+
+    for (uint32_t y = 0; y < height; ++y)
+    {
+        for (uint32_t x = 0; x < width; ++x)
+        {
+            uint32_t texel;
+            if (state.prim.fst)
+            {
+                const uint16_t fixedU = static_cast<uint16_t>(std::min<uint32_t>(x * 16u, 0xFFFFu));
+                const uint16_t fixedV = static_cast<uint16_t>(std::min<uint32_t>(y * 16u, 0xFFFFu));
+                texel = SampleTexture(state, 0.0f, 0.0f, 1.0f, fixedU, fixedV);
+            }
+            else
+            {
+                texel = SampleTexture(state, static_cast<float>(x) / static_cast<float>(width),
+                                      static_cast<float>(y) / static_cast<float>(height), 1.0f, 0u, 0u);
+            }
+            dst[static_cast<size_t>(y) * width + x] = texel;
+        }
+    }
+}
