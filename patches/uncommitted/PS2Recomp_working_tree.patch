+const uint32_t *GSCpuBackend::linearTexture(const GSDrawState &state)
+{
+    static thread_local LinearTexture cache;
+    if (!t_stageLinearTexture || !state.prim.tme || state.textureWidth == 0u || state.textureHeight == 0u)
+        return nullptr;
