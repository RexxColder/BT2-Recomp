+namespace
+{
+    bool vif1ThreadEnabled()
+    {
+        static const bool enabled = []()
+        {
+            const char *value = std::getenv("PS2X_VIF1_THREAD");
+            return !value || std::strcmp(value, "0") != 0;
+        }();
+        return enabled;
+    }
+
+    // PS2X_VIF1_STATS=1: every 5 s, how many VIF1 transfers ran on the worker and how often (and how long)
+    // the EE thread had to wait for one.
+    struct Vif1Stats
+    {
+        std::atomic<uint64_t> jobs{0};
+        std::atomic<uint64_t> waits{0};
+        std::atomic<uint64_t> waitNs{0};
+        void report()
+        {
+            static const bool enabled = std::getenv("PS2X_VIF1_STATS") != nullptr;
+            static auto last = std::chrono::steady_clock::now();
+            if (!enabled || std::chrono::steady_clock::now() - last < std::chrono::seconds(5))
+                return;
+            last = std::chrono::steady_clock::now();
+            std::fprintf(stderr, "[vif1 thread] jobs %llu waits %llu wait-ms %llu\n",
+                         static_cast<unsigned long long>(jobs.load()), static_cast<unsigned long long>(waits.load()),
+                         static_cast<unsigned long long>(waitNs.load() / 1000000u));
+        }
+    };
+    Vif1Stats g_vif1Stats;
+}
+
+// Hands the pending VIF1 transfers to the worker thread when they are the only pending DMA work. The data is
+// copied now (chains already are), so the EE may reuse its buffers once the channel reports completion.
+bool PS2Memory::startVif1Job()
+{
+    if (m_pendingVif1Transfers.empty() || !m_pendingGifTransfers.empty() || !m_pendingVif0Transfers.empty() ||
+        !vif1ThreadEnabled() || onVif1Worker())
+        return false;
+    // One VIF1 transfer at a time, as the channel runs one chain at a time.
+    waitVif1Idle();
+
+    Vif1Job job;
+    for (auto &p : m_pendingVif1Transfers)
+    {
+        if (!p.chainData.empty())
+        {
+            job.chunks.push_back(std::move(p.chainData));
+            continue;
+        }
+        if (p.qwc == 0u)
+            continue;
+        uint32_t srcPhys = 0;
+        try
+        {
+            srcPhys = translateAddress(p.srcAddr);
+        }
+        catch (const std::exception &)
+        {
+            continue;
+        }
+        const uint8_t *base = p.fromScratchpad ? m_scratchpad : m_rdram;
+        const uint32_t limit = p.fromScratchpad ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+        uint32_t bytesLeft = static_cast<uint32_t>(std::min<uint64_t>(static_cast<uint64_t>(p.qwc) * 16ull, 0xFFFFFFFFull));
+        while (bytesLeft > 0u)
+        {
+            if (srcPhys >= limit)
+                srcPhys = 0;
+            const uint32_t chunk = std::min(bytesLeft, limit - srcPhys);
+            if (chunk == 0u)
+                break;
+            job.chunks.emplace_back(base + srcPhys, base + srcPhys + chunk);
+            bytesLeft -= chunk;
+            srcPhys += chunk;
+        }
+    }
+    m_pendingVif1Transfers.clear();
+
+    {
+        std::lock_guard<std::mutex> lock(m_vif1Mutex);
+        if (!m_vif1Worker.joinable())
+        {
+            m_vif1Stop = false;
+            m_vif1Worker = std::thread([this]()
+                                       { vif1WorkerLoop(); });
+            m_vif1WorkerId = m_vif1Worker.get_id();
+        }
+        m_vif1Jobs.push_back(std::move(job));
+        m_vif1Outstanding.fetch_add(1u, std::memory_order_acq_rel);
+    }
+    g_vif1Stats.jobs.fetch_add(1u, std::memory_order_relaxed);
+    g_vif1Stats.report();
+    m_vif1Cv.notify_one();
+    return true;
+}
+
+void PS2Memory::vif1WorkerLoop()
+{
+    for (;;)
+    {
+        Vif1Job job;
+        {
+            std::unique_lock<std::mutex> lock(m_vif1Mutex);
+            m_vif1Cv.wait(lock, [this]()
+                          { return m_vif1Stop || !m_vif1Jobs.empty(); });
+            if (m_vif1Jobs.empty())
+                return;
+            job = std::move(m_vif1Jobs.front());
+            m_vif1Jobs.pop_front();
+        }
+        for (const std::vector<uint8_t> &chunk : job.chunks)
+            processVIF1Data(chunk.data(), static_cast<uint32_t>(chunk.size()));
+        if (m_gifArbiter)
+            m_gifArbiter->drain();
+        m_vif1Finished.fetch_add(1u, std::memory_order_acq_rel);
+        {
+            std::lock_guard<std::mutex> lock(m_vif1Mutex);
+            m_vif1Outstanding.fetch_sub(1u, std::memory_order_acq_rel);
+        }
+        m_vif1IdleCv.notify_all();
+        if (m_vif1CompletionCallback)
+            m_vif1CompletionCallback();
+    }
+}
+
+void PS2Memory::stopVif1Worker()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_vif1Mutex);
+        m_vif1Stop = true;
+    }
+    m_vif1Cv.notify_all();
+    if (m_vif1Worker.joinable())
+        m_vif1Worker.join();
+}
+
+void PS2Memory::waitVif1Idle()
+{
+    if (onVif1Worker() || m_vif1Outstanding.load(std::memory_order_acquire) == 0u)
+        return;
+    const auto start = std::chrono::steady_clock::now();
+    {
+        std::unique_lock<std::mutex> lock(m_vif1Mutex);
+        m_vif1IdleCv.wait(lock, [this]()
+                          { return m_vif1Outstanding.load(std::memory_order_acquire) == 0u; });
+    }
+    g_vif1Stats.waits.fetch_add(1u, std::memory_order_relaxed);
+    g_vif1Stats.waitNs.fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                                           std::chrono::steady_clock::now() - start)
+                                                           .count()),
+                                 std::memory_order_relaxed);
+}
+
+bool PS2Memory::pollVif1()
+{
+    if (onVif1Worker() || m_vif1Finished.load(std::memory_order_acquire) == 0u)
+        return false;
+    static constexpr uint32_t VIF1_CHANNEL = 0x10009000u;
+    for (uint32_t irqs = m_vif1GsIrqs.exchange(0u, std::memory_order_acq_rel); irqs != 0u; --irqs)
+        if (m_raiseDeferredGsInterrupt)
+            m_raiseDeferredGsInterrupt();
+    for (uint32_t finished = m_vif1Finished.exchange(0u, std::memory_order_acq_rel); finished != 0u; --finished)
+    {
+        completeDmacChannel(VIF1_CHANNEL, 1u);
+        m_ioRegisters[VIF1_CHANNEL + 0x20] = 0;
+    }
+    // A later transfer started before this completion was applied is still running: keep STR set for it.
+    if (vif1Busy())
+        m_ioRegisters[VIF1_CHANNEL] |= 0x100u;
+    return true;
+}
+
+// Guest accesses that see what a VIF1 transfer changes wait for it; DMAC register reads only pick up a
+// finished one (a running channel still reads as busy, as on the console).
+void PS2Memory::syncVif1ForAddress(uint32_t address)
+{
+    if (m_vif1Outstanding.load(std::memory_order_relaxed) == 0u && m_vif1Finished.load(std::memory_order_relaxed) == 0u)
+        return;
+    if (onVif1Worker() || isScratchpad(address))
+        return;
+    const uint32_t phys = address & 0x1FFFFFFFu;
+    if (phys >= 0x10008000u && phys < 0x1000F000u)
+    {
+        pollVif1();
+        return;
+    }
+    if ((phys >= 0x10003000u && phys < 0x10008000u) || // GIF/VIF registers and FIFOs
+        (phys >= 0x11008000u && phys < 0x11010000u) || // VU1 micro and data memory
+        (phys >= 0x12000000u && phys < 0x12002000u))   // GS privileged registers
+    {
+        waitVif1Idle();
+        pollVif1();
+    }
+}
