diff --git a/ps2xRuntime/src/tools/vu1_replay.cpp b/ps2xRuntime/src/tools/vu1_replay.cpp
new file mode 100644
index 0000000..eeae2c5
--- /dev/null
+++ b/ps2xRuntime/src/tools/vu1_replay.cpp
@@ -0,0 +1,81 @@
+// Replays VU1 microprograms recorded with PS2X_VU1_RECORD and prints one line per record:
+//   <file> <hash> <cycles> <packets>
+// The hash covers the final registers, VU1 data memory and every XGKICK packet, so two builds of the
+// interpreter that print the same lines produced the same results with the same timing.
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/ps2_vu1.h"
+#include "runtime/vu1_record.h"
+
+#include <cstdio>
+#include <cstring>
+
+namespace
+{
+    struct Hasher
+    {
+        uint64_t value = 1469598103934665603ull;
+        void add(const void *bytes, size_t size)
+        {
+            const uint8_t *p = static_cast<const uint8_t *>(bytes);
+            for (size_t i = 0; i < size; ++i)
+                value = (value ^ p[i]) * 1099511628211ull;
+        }
+        template <typename T>
+        void addValue(const T &item) { add(&item, sizeof(item)); }
+    };
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 2)
+    {
+        std::fprintf(stderr, "usage: %s mscal_*.bin...\n", argv[0]);
+        return 2;
+    }
+    GS gs;
+    int failures = 0;
+    for (int index = 1; index < argc; ++index)
+    {
+        Vu1Record record;
+        if (!record.load(argv[index]))
+        {
+            std::printf("%s unreadable\n", argv[index]);
+            ++failures;
+            continue;
+        }
+        Hasher hasher;
+        uint32_t packets = 0;
+        VU1Interpreter vu(VU1Interpreter::Unit::VU1);
+        vu.setPacketSink([&](const uint8_t *data, uint32_t size)
+                         {
+                             ++packets;
+                             hasher.addValue(size);
+                             hasher.add(data, size); });
+        vu.state() = record.state;
+        if (record.resume)
+            vu.resume(record.code.data(), static_cast<uint32_t>(record.code.size()),
+                      record.data.data(), static_cast<uint32_t>(record.data.size()),
+                      gs, nullptr, record.top, record.itop, 65536);
+        else
+            vu.execute(record.code.data(), static_cast<uint32_t>(record.code.size()),
+                       record.data.data(), static_cast<uint32_t>(record.data.size()),
+                       gs, nullptr, record.startPC, record.top, record.itop, 65536);
+        const VU1State &s = vu.state();
+        hasher.add(s.vf, sizeof(s.vf));
+        hasher.add(s.vi, sizeof(s.vi));
+        hasher.add(s.acc, sizeof(s.acc));
+        for (const auto value : {s.q, s.p, s.i})
+            hasher.addValue(value);
+        for (const auto value : {s.r, s.pc, s.mac, s.clip, s.status})
+            hasher.addValue(value);
+        hasher.addValue(s.cycles);
+        for (const bool value : {s.ebit, s.stoppedByD, s.stoppedByT, s.branchPending})
+            hasher.addValue(value);
+        hasher.add(record.data.data(), record.data.size());
+        const char *name = std::strrchr(argv[index], '/');
+        std::printf("%s %c %016llx %llu %u\n", name ? name + 1 : argv[index], record.resume ? 'c' : 's',
+                    static_cast<unsigned long long>(hasher.value),
+                    static_cast<unsigned long long>(s.cycles), packets);
+    }
+    return failures == 0 ? 0 : 1;
+}
