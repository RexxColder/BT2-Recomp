@@ -0,0 +1,100 @@
+#ifndef PS2_VU1_RECORD_H
+#define PS2_VU1_RECORD_H
+
+#include "runtime/ps2_vu1.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+// Snapshot of one VU1 microprogram start (MSCAL) or continuation (MSCNT): registers, micro memory and data memory. Recorded by the
+// runtime with PS2X_VU1_RECORD=<dir> (PS2X_VU1_RECORD_COUNT=n, default 2000; PS2X_VU1_RECORD_EVERY=k keeps every
+// k-th program, default 1) and replayed by ps2x_vu1_replay to
+// check that interpreter changes keep the same results (registers, data memory, XGKICK packets, cycles).
+struct Vu1Record
+{
+    static constexpr uint32_t kMagic = 0x52315556u; // "VU1R"
+    static constexpr uint32_t kVersion = 2u;
+
+    bool resume = false; // MSCNT: continue at state.pc
+    uint32_t startPC = 0;
+    uint32_t top = 0;
+    uint32_t itop = 0;
+    VU1State state{};
+    std::vector<uint8_t> code;
+    std::vector<uint8_t> data;
+
+    bool save(const std::string &path) const
+    {
+        FILE *file = std::fopen(path.c_str(), "wb");
+        if (!file)
+            return false;
+        const uint32_t header[8] = {kMagic, kVersion, startPC, top, itop,
+                                    static_cast<uint32_t>(code.size()), static_cast<uint32_t>(data.size()),
+                                    resume ? 1u : 0u};
+        bool ok = std::fwrite(header, sizeof(header), 1, file) == 1 &&
+                  std::fwrite(&state, sizeof(state), 1, file) == 1 &&
+                  std::fwrite(code.data(), 1, code.size(), file) == code.size() &&
+                  std::fwrite(data.data(), 1, data.size(), file) == data.size();
+        return std::fclose(file) == 0 && ok;
+    }
+
+    bool load(const std::string &path)
+    {
+        FILE *file = std::fopen(path.c_str(), "rb");
+        if (!file)
+            return false;
+        uint32_t header[8]{};
+        bool ok = std::fread(header, sizeof(header), 1, file) == 1 && header[0] == kMagic && header[1] == kVersion &&
+                  std::fread(&state, sizeof(state), 1, file) == 1;
+        if (ok)
+        {
+            startPC = header[2];
+            top = header[3];
+            itop = header[4];
+            resume = header[7] != 0u;
+            code.resize(header[5]);
+            data.resize(header[6]);
+            ok = std::fread(code.data(), 1, code.size(), file) == code.size() &&
+                 std::fread(data.data(), 1, data.size(), file) == data.size();
+        }
+        std::fclose(file);
+        return ok;
+    }
+};
+
+// Called before each VU1 MSCAL/MSCNT; records the first PS2X_VU1_RECORD_COUNT programs.
+inline void recordVu1Program(const VU1State &state, const uint8_t *code, uint32_t codeSize,
+                             const uint8_t *data, uint32_t dataSize, uint32_t startPC, uint32_t top, uint32_t itop, bool resume)
+{
+    static const char *directory = std::getenv("PS2X_VU1_RECORD");
+    if (!directory)
+        return;
+    static const uint32_t limit = std::getenv("PS2X_VU1_RECORD_COUNT")
+                                      ? static_cast<uint32_t>(std::strtoul(std::getenv("PS2X_VU1_RECORD_COUNT"), nullptr, 0))
+                                      : 2000u;
+    static const uint32_t every = std::getenv("PS2X_VU1_RECORD_EVERY")
+                                      ? std::max(1ul, std::strtoul(std::getenv("PS2X_VU1_RECORD_EVERY"), nullptr, 0))
+                                      : 1u;
+    static uint32_t count = 0;
+    static uint64_t seen = 0;
+    if (count >= limit || (seen++ % every) != 0u)
+        return;
+    Vu1Record record;
+    record.resume = resume;
+    record.startPC = startPC;
+    record.top = top;
+    record.itop = itop;
+    record.state = state;
+    record.code.assign(code, code + codeSize);
+    record.data.assign(data, data + dataSize);
+    char name[32];
+    std::snprintf(name, sizeof(name), "/mscal_%06u.bin", count++);
+    record.save(std::string(directory) + name);
+}
+
+#endif
